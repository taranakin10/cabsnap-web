---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, ANALYTICS } from '../config';
import { ogImageFor } from '../data/og';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/vs/shoeboxed". Used for the canonical tag. */
  path: string;
  ogImage?: string;
  /** Ad landing pages drop the nav and footer — one CTA, no exits. */
  bare?: boolean;
  /**
   * Pages that are a single column of running text — the comparisons, the
   * roundup, and everything on the Prose layout. They hold a 760px column on
   * desktop instead of the full container, which for a page with no grids
   * and no media would only add empty space to the right of the text.
   *
   * Set here rather than per page so the rule lives in one place: it drives
   * a class on <body>, and global.css does the rest.
   */
  narrow?: boolean;
  /**
   * Keep this page out of search on its own account, regardless of environment.
   * Set by Landing.astro for the /lp/* ad pages, which are bought traffic and
   * should never compete in organic results with the pages they mimic.
   * Do not set this on anything a visitor could arrive at from search.
   */
  noindex?: boolean;
  /** Any FAQ block on the page, emitted as FAQPage schema. */
  /** href/hrefLabel are for rendering only; the schema uses `a` alone. */
  faq?: { q: string; a: string; href?: string; hrefLabel?: string }[];
  /** Set on /guide and /blog articles, emitted as Article schema. */
  article?: { headline: string; published: string; modified?: string };
}

const {
  title,
  description,
  path,
  // Per-page card generated at build time by src/pages/og/[slug].png.ts.
  ogImage = ogImageFor(path),
  bare = false,
  narrow = false,
  noindex: pageNoindex = false,
  faq,
  article,
} = Astro.props;

// Everything absolute on the page hangs off Astro.site, which is
// PUBLIC_SITE_URL (see astro.config.mjs). No page types a host of its own.
const canonical = new URL(path, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;

/**
 * Two independent reasons to noindex, and the defaults run in opposite
 * directions on purpose:
 *
 *   pageNoindex  — the page asks for it (the /lp/* ad pages). Defaults false.
 *   envNoindex   — the whole deploy asks for it (staging). Defaults false, and
 *                  ONLY the exact string 'true' turns it on. Unset, empty,
 *                  'false' and whitespace all leave the page indexable.
 *
 * Never invert that second default. A missing variable that noindexes the site
 * is a failure with no symptom until the traffic is already gone — which is
 * what happened over 8-10 Aug 2026. astro.config.mjs now hard-fails the build
 * if this switch is on while building for the production host, so the global
 * form cannot reach www.getcabsnap.com again by accident.
 */
const envNoindex = import.meta.env.PUBLIC_NOINDEX?.trim().toLowerCase() === 'true';
const noindex = pageNoindex || envNoindex;

// IDs come from config; an env var of the same name overrides, and setting one
// to an empty string switches that tool off for a given deploy.
const GA4_ID = import.meta.env.PUBLIC_GA4_ID ?? ANALYTICS.ga4;
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID ?? ANALYTICS.metaPixel;
const CLARITY_ID = import.meta.env.PUBLIC_CLARITY_ID ?? ANALYTICS.clarity;

const FONT_CSS =
  'https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;800;900&family=Courier+Prime:wght@400;700&family=Inter:wght@400;500;600&display=swap';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: Astro.site?.href,
  email: SITE.email,
  parentOrganization: { '@type': 'Organization', name: SITE.company },
};

const articleSchema = article && {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.headline,
  description,
  datePublished: article.published,
  dateModified: article.modified ?? article.published,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: { '@type': 'Organization', name: SITE.name, url: Astro.site?.href },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    parentOrganization: { '@type': 'Organization', name: SITE.company },
  },
};

const faqSchema = faq && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />

  <meta name="theme-color" content="#14213D" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {/* Loaded non-render-blocking: as a print stylesheet first, promoted to all
      media once it arrives. Blocking on this cost ~850ms of first paint. */}
  <link rel="preload" as="style" href={FONT_CSS} />
  <link rel="stylesheet" href={FONT_CSS} media="print" onload="this.media='all';this.onload=null" />
  <noscript><link rel="stylesheet" href={FONT_CSS} /></noscript>

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  {/* Analytics. All three are is:inline so Astro leaves them alone — bundled,
      the globals (gtag, fbq, clarity) would be closure-scoped and the event
      calls further down the page would silently find nothing.

      These sit in <head>, above the click handler in <body>, so fbq and gtag
      both exist before any click can fire. */}

  {GA4_ID && (
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
  )}
  {GA4_ID && (
    <script is:inline define:vars={{ GA4_ID }}>
      // Assigned to window explicitly: define:vars wraps this script in an
      // IIFE, so Google's stock `function gtag(){}` would be scoped to that
      // closure and the event calls elsewhere would never find it.
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){ window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', GA4_ID);
    </script>
  )}

  {META_PIXEL_ID && (
    <script is:inline define:vars={{ META_PIXEL_ID }}>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;
      s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', META_PIXEL_ID);
      fbq('track', 'PageView');
    </script>
  )}

  {CLARITY_ID && (
    <script is:inline define:vars={{ CLARITY_ID }}>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", CLARITY_ID);
    </script>
  )}
</head>

<body class={narrow ? 'narrow' : undefined}>
  {META_PIXEL_ID && (
    <noscript>
      <img
        height="1" width="1" style="display:none" alt=""
        src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`}
      />
    </noscript>
  )}

  {!bare && <Nav />}
  <slot />
  {!bare && <Footer />}

  <script>
    // iOS visitors cannot install CabSnap, so the primary CTA is swapped for a
    // plain statement rather than sending them to a Play Store page they
    // cannot use. Deliberately client-side and post-parse: the static HTML and
    // everything a crawler sees keep the real Play Store button.
    (() => {
      const ua = navigator.userAgent;
      const isIOS =
        /iPad|iPhone|iPod/.test(ua) ||
        // iPadOS 13+ reports itself as a Mac; touch points tell them apart.
        (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      if (!isIOS) return;

      document.querySelectorAll<HTMLAnchorElement>('a.btn[data-play-store]').forEach((btn) => {
        const card = document.createElement('div');
        card.className = 'ios-card';
        // Height is pinned to the button it replaces so the swap does not
        // push the rest of the page around.
        card.style.minHeight = `${Math.round(btn.getBoundingClientRect().height)}px`;

        const h = document.createElement('strong');
        h.textContent = 'Not on iPhone yet';
        const p = document.createElement('span');
        p.textContent =
          'CabSnap is Android only right now. The iPhone version is in development.';

        // The one actionable thing an iPhone visitor can do: join the list.
        const a = document.createElement('a');
        a.href = '/iphone';
        a.className = 'ios-card-link';
        a.textContent = 'Get notified';

        card.append(h, p, a);

        btn.replaceWith(card);
      });

      // The Play badge sits under the button and points at the same place, so
      // it has to go too — leaving it would put a live "Get it on Google Play"
      // next to a card saying the app is not available.
      document.querySelectorAll('a.gp-badge').forEach((b) => b.remove());

      // The nav button leads to the same place, so it goes too.
      document.querySelectorAll<HTMLAnchorElement>('a.nav-cta[data-play-store]').forEach((a) => {
        a.setAttribute('href', '/iphone');
        a.removeAttribute('data-play-store');
        const label = a.querySelector('span');
        if (label) label.textContent = 'On iPhone?';
      });
    })();
  </script>

  <script>
    // Preserve UTM parameters through to the Play Store so campaign
    // attribution survives the handoff, and fire PlayStoreClick.
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement)?.closest?.('a[data-play-store]');
      if (!link) return;

      const params = new URLSearchParams(window.location.search);
      const utms = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term']
        .filter((k) => params.get(k))
        .map((k) => `${k}=${encodeURIComponent(params.get(k)!)}`);

      // Landing pages carry ?v=a|b|c. Pass it through so the install can be
      // attributed to the variant that produced it.
      const variant = params.get('v');
      if (variant && /^[a-c]$/.test(variant)) {
        utms.push(`cabsnap_variant=${encodeURIComponent(variant)}`);
      }

      if (utms.length) {
        const url = new URL((link as HTMLAnchorElement).href);
        url.searchParams.set('referrer', utms.join('&'));
        (link as HTMLAnchorElement).href = url.toString();
      }

      const payload: Record<string, string> = { page: window.location.pathname };
      if (variant) payload.variant = variant;

      if (typeof (window as any).fbq === 'function') {
        (window as any).fbq('trackCustom', 'PlayStoreClick', payload);
      }
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'play_store_click', {
          page_path: window.location.pathname,
          ...(variant ? { variant } : {}),
        });
      }
    });
  </script>
</body>
</html>
