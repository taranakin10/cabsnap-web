---
/**
 * iOS waitlist form.
 *
 * Appears on /iphone only. Everywhere else the Play Store install stays the
 * single CTA — a second ask on the main pages would compete with it.
 *
 * The SMS consent checkbox is hidden until what has been typed parses as a
 * phone number, so an email signup is never shown an irrelevant SMS box, and
 * a phone signup cannot miss it. Submission of a phone without the tick is
 * blocked here and again by the RLS policy on the table.
 */
---
<div class="wl">
  <form id="wl-form" novalidate>
    <label class="sr-only" for="wl-contact">Email or phone number</label>
    <input
      id="wl-contact"
      name="contact"
      type="text"
      placeholder="Email or phone number"
      inputmode="email"
      autocomplete="email"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
      required
    />

    <div class="consent" id="wl-consent" hidden>
      <label>
        <input type="checkbox" id="wl-sms" name="sms_consent" />
        <span>
          Text me when the iPhone app launches. Message and data rates may
          apply. Reply STOP to opt out.
        </span>
      </label>
    </div>

    <p class="err" id="wl-err" role="alert" hidden></p>

    <button class="btn" type="submit" id="wl-submit">Tell me when it's ready</button>
    <p class="note">One message when the iPhone version launches. Nothing else.</p>
    <p class="fine">
      We use this only to send that one message. See our
      <a href="/privacy">privacy policy</a>.
    </p>
  </form>

  <div class="done" id="wl-done" hidden role="status">
    <strong>You're on the list.</strong>
    <span>We'll message you once — when it's actually ready.</span>
  </div>
</div>

<script>
  import { submitWaitlist, parseContact } from '../lib/waitlist';

  const form = document.getElementById('wl-form') as HTMLFormElement | null;
  if (form) {
    const input = document.getElementById('wl-contact') as HTMLInputElement;
    const consentWrap = document.getElementById('wl-consent') as HTMLElement;
    const consent = document.getElementById('wl-sms') as HTMLInputElement;
    const err = document.getElementById('wl-err') as HTMLElement;
    const submit = document.getElementById('wl-submit') as HTMLButtonElement;
    const done = document.getElementById('wl-done') as HTMLElement;

    const showError = (msg: string) => {
      err.textContent = msg;
      err.hidden = false;
    };
    const clearError = () => {
      err.hidden = true;
      err.textContent = '';
    };

    // Reveal the SMS consent box only once the input looks like a phone
    // number, and swap the keyboard hints to match what they are typing.
    const sync = () => {
      const parsed = parseContact(input.value);
      const isPhone = parsed?.type === 'phone';
      const looksNumeric = /^[\d\s().+-]+$/.test(input.value.trim()) && input.value.trim() !== '';

      consentWrap.hidden = !isPhone;
      if (!isPhone) consent.checked = false;

      input.setAttribute('inputmode', looksNumeric ? 'tel' : 'email');
      input.setAttribute('autocomplete', looksNumeric ? 'tel' : 'email');
      clearError();
    };

    input.addEventListener('input', sync);
    sync();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();

      const parsed = parseContact(input.value);
      if (!parsed) {
        showError('Enter an email address or a US phone number.');
        input.focus();
        return;
      }
      if (parsed.type === 'phone' && !consent.checked) {
        consentWrap.hidden = false;
        showError('Tick the box above so we can text you.');
        consent.focus();
        return;
      }

      submit.disabled = true;
      const original = submit.textContent;
      submit.textContent = 'Adding you…';

      const result = await submitWaitlist(input.value, consent.checked);

      if (result.ok) {
        form.hidden = true;
        done.hidden = false;

        const payload = { page: window.location.pathname, contact_type: parsed.type };
        if (typeof (window as any).fbq === 'function') {
          (window as any).fbq('trackCustom', 'IosWaitlistSignup', payload);
        }
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'IosWaitlistSignup', payload);
        }
        return;
      }

      submit.disabled = false;
      submit.textContent = original;
      if (result.reason === 'invalid') showError('Enter an email address or a US phone number.');
      else if (result.reason === 'needs_consent') showError('Tick the box above so we can text you.');
      else showError("That didn't go through. Try again in a moment.");
    });
  }
</script>

<style>
  .wl { margin-top: 26px; }
  /* A single-field form does not want a 1036px input. */
  @media (min-width: 768px) { .wl { max-width: 520px; } }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  #wl-contact {
    display: block; width: 100%;
    font-family: var(--font-body); font-size: 16px; /* 16px avoids iOS zoom */
    color: var(--text);
    background: var(--paper);
    border: 2px solid var(--rule);
    border-radius: 4px;
    padding: 15px 14px;
  }
  #wl-contact::placeholder { color: var(--muted); }
  #wl-contact:focus-visible {
    outline: none;
    border-color: var(--orange);
  }

  .consent { margin-top: 14px; }
  .consent label {
    display: grid; grid-template-columns: auto 1fr; gap: 10px;
    align-items: start; cursor: pointer;
  }
  .consent input {
    width: 20px; height: 20px; margin-top: 1px;
    accent-color: var(--orange); flex: none;
  }
  .consent span {
    font-size: 13.5px; line-height: 1.45; color: var(--text-body);
  }

  .err {
    margin-top: 12px; font-family: var(--font-mono); font-size: 12.5px;
    line-height: 1.5; color: var(--orange-ink);
  }

  .note {
    text-align: center; margin-top: 10px;
    font-family: var(--font-mono); font-size: 12.5px; color: var(--muted);
  }
  .fine {
    text-align: center; margin-top: 8px;
    font-family: var(--font-mono); font-size: 11.5px; color: var(--muted);
  }
  .fine a { color: var(--orange-ink); }

  .done {
    border: 2px solid var(--orange); border-radius: 4px;
    background: var(--card); padding: 22px 18px; text-align: center;
    display: flex; flex-direction: column; gap: 6px;
  }
  .done strong {
    font-family: var(--font-display); font-weight: 900;
    text-transform: uppercase; font-size: 24px; line-height: 1.05;
    color: var(--text);
  }
  .done span { font-size: 15px; color: var(--text-body); }
</style>
