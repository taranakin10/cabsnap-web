---
import Cta from './Cta.astro';

/**
 * Audience-page hero: photo stage with the copy overlaid on the bottom edge.
 * The photo is min-height 55vh (capped 480px on desktop) and grows if the
 * copy needs more room, so the h1 and CTA always sit above the fold.
 *
 * Pages provide <h1 slot="h1"> and <p slot="lead" class="lead">.
 */
interface Props {
  img: string;
  alt: string;
  eyebrow: string;
}
const { img, alt, eyebrow } = Astro.props;
---

<header class="dark hero">
  <div class="hero-photo">
    <img src={img} width="900" height="900" fetchpriority="high" alt={alt} />
    <div class="wrap hero-copy">
      <p class="eyebrow orange">{eyebrow}</p>
      <slot name="h1" />
      <slot name="lead" />
      <Cta />
    </div>
  </div>
</header>

<style>
  .hero { padding-bottom: 40px; }
  .hero-photo {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 55vh;
  }
  @media (min-width: 768px) {
    .hero-photo { min-height: min(55vh, 480px); max-height: 480px; }
  }
  .hero-photo > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-photo::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg,
      rgba(20,33,61,.5) 0%, rgba(20,33,61,.1) 35%,
      rgba(20,33,61,.45) 70%, var(--navy) 100%);
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: 26px;
    padding-bottom: 18px;
  }
  .eyebrow.orange { color: var(--orange); }
  .hero-copy :global(h1 em) { font-style: normal; color: var(--orange); }
  .hero-copy :global(.lead) { font-size: 18px; margin-top: 16px; }
</style>
