---
/**
 * `a` stays plain text so it can go straight into FAQPage schema. Where an
 * answer needs to point somewhere, use `href`/`hrefLabel` rather than putting
 * markup in `a` — the schema should not carry HTML.
 */
interface Props {
  items: { q: string; a: string; href?: string; hrefLabel?: string }[];
}
const { items } = Astro.props;
---
<div class="faq">
  {items.map(({ q, a, href, hrefLabel }) => (
    <details>
      <summary>{q}</summary>
      <p>
        {a}
        {href && <> <a href={href}>{hrefLabel ?? 'Read more'}</a></>}
      </p>
    </details>
  ))}
</div>

<style>
  details { border-bottom: 1px solid var(--rule); padding: 16px 0; }
  summary {
    cursor: pointer; list-style: none;
    font-family: var(--font-display); font-weight: 800;
    text-transform: uppercase; font-size: 19px; line-height: 1.15;
    display: flex; justify-content: space-between; gap: 14px;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; color: var(--orange-ink); font-size: 24px; line-height: 1; }
  details[open] summary::after { content: "\2013"; }
  details p { margin-top: 11px; font-size: 15.5px; }
  details a { color: var(--orange-ink); }

  /* An accordion gains nothing from width. Past this the summary row just
     drags the "+" further from the question it belongs to, and the answers
     turn into single long lines. Held at a single centred column — the
     section around it carries .narrow so the heading shares these edges
     rather than starting further left than the questions. */
  @media (min-width: 768px) {
    .faq { max-width: 760px; margin-inline: auto; }
    details p { max-width: 68ch; }
  }

  /* At 1080px the rows were reading as cramped against the whitespace
     around them — the question is the thing being scanned, so it takes
     more of both. */
  @media (min-width: 1024px) {
    details { padding: 20px 0; }
    summary { font-size: 21px; }
  }
</style>
