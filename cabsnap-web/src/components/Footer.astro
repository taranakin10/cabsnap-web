---
import { SITE, DISCLAIMER, CONTACTS } from '../config';
const links = [
  ['/receipt-app-for-truck-drivers', 'Truck drivers'],
  ['/receipt-app-for-owner-operators', 'Owner-operators'],
  ['/receipt-app-for-lease-operators', 'Lease operators'],
  ['/receipt-app-for-1099-contractors', '1099 contractors'],
  ['/receipt-app-for-gig-drivers', 'Gig drivers'],
  ['/receipt-app-for-local-drivers', 'Local & regional'],
  ['/best-receipt-app-for-truck-drivers', 'Best receipt apps'],
  ['/vs/shoeboxed', 'vs Shoeboxed'],
  ['/vs/expensify', 'vs Expensify'],
  ['/vs/spreadsheets', 'vs Spreadsheets'],
  ['/vs/glovebox', 'vs The glovebox'],
  ['/tools/undocumented-spend-calculator', 'Free calculator'],
  ['/guide', 'Guides'],
  ['/blog', 'Blog'],
  ['/about', 'About'],
  ['/security', 'Security'],
  ['/privacy', 'Privacy'],
  ['/terms', 'Terms'],
];
---
<footer>
  <div class="wrap">
    <div class="flinks">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </div>
    <p>{SITE.name} is a product of {SITE.company}, {SITE.companyLocation}</p>
    <p class="contacts">
      General <a href={`mailto:${CONTACTS.general}`}>{CONTACTS.general}</a> &middot;
      Privacy <a href={`mailto:${CONTACTS.privacy}`}>{CONTACTS.privacy}</a> &middot;
      Security <a href={`mailto:${CONTACTS.security}`}>{CONTACTS.security}</a>
    </p>
    <p class="disclaimer">{DISCLAIMER}</p>
  </div>
</footer>

<style>
  footer {
    background: var(--navy); color: var(--muted-dk);
    padding: 8px 0 44px; font-size: 13px; font-family: var(--font-mono);
  }
  footer p { color: var(--muted-dk); }
  .flinks {
    display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 18px;
    padding-top: 26px; border-top: 1px solid var(--rule-dk);
  }
  .flinks a { color: var(--muted-dk); }
  .contacts { margin-top: 7px; line-height: 1.7; }
  .contacts a { color: var(--muted-dk); }
  .disclaimer {
    border-top: 1px solid var(--rule-dk); padding-top: 16px;
    margin-top: 16px; line-height: 1.5; font-size: 12px;
  }
</style>
