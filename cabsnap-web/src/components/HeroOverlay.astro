---
import Cta from './Cta.astro';

/**
 * Audience-page hero: a photo band, then the copy beneath it in normal flow.
 *
 * The copy is NOT overlaid. It used to be, and when the text grew taller than
 * the photo the top of the h1 was clipped. Nothing here constrains the copy's
 * height, so the section is always as tall as its content.
 *
 * Shared layout lives in global.css so this and the homepage stay identical.
 * Pages provide <h1 slot="h1"> and <p slot="lead" class="lead">.
 */
interface Props {
  img: string;
  alt: string;
  eyebrow: string;
}
const { img, alt, eyebrow } = Astro.props;
---

<header class="dark hero">
  {/* .hero-in carries no styles below 1024px — it is the grid container the
      two-column desktop hero needs, and inert everywhere else. */}
  <div class="hero-in">
    <div class="hero-photo">
      <img src={img} width="900" height="900" fetchpriority="high" alt={alt} />
    </div>
    <div class="hero-copy">
      <div class="wrap">
        <p class="eyebrow orange">{eyebrow}</p>
        <slot name="h1" />
        <slot name="lead" />
        <Cta />
      </div>
    </div>
  </div>
</header>

<style>
  /* .hero-photo and .hero-copy live in global.css so this and the homepage
     cannot drift apart again. No height is set here on purpose. */
  .eyebrow.orange { color: var(--orange); }
  .hero-copy :global(h1 em) { font-style: normal; color: var(--orange); }
  .hero-copy :global(.lead) { font-size: 18px; margin-top: 16px; }
</style>
