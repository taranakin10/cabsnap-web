---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import IrsProof from '../components/IrsProof.astro';
import { SITE, AUDIENCES } from '../config';

const faq = [
  {
    q: 'Does the IRS accept photos of receipts?',
    a: 'Yes. Under Rev. Proc. 97-22 the IRS accepts electronic copies of paper records, provided the image is legible, matches the original, can be printed on request, and is stored securely. This is a recordkeeping answer, not tax advice — talk to your tax preparer about your own situation.',
  },
  {
    q: 'Does CabSnap track my miles?',
    a: "No. CabSnap does one job: capturing and keeping receipts. If you need mileage tracking, you'll want a separate app for that. We'd rather be excellent at one thing than mediocre at two.",
  },
  {
    q: 'Is there an iPhone version?',
    a: "Not yet — CabSnap is Android only. An iPhone version is in development. There's no release date I can promise you yet.",
    href: '/iphone',
    hrefLabel: 'More on the iPhone version',
  },
  {
    q: 'What if the AI reads a receipt wrong?',
    a: 'You can correct any field yourself. And the original photo is always kept alongside the data, so even if a number is off, the actual receipt image is still there as your proof.',
  },
  {
    q: "Can I use this if I'm not a trucker?",
    a: 'Yes. It is built around the way owner-operators work, but anyone buying their own supplies as a 1099 contractor — rideshare, delivery, trades — has the same problem with the same paper.',
  },
  {
    q: 'Do I still need to keep the paper receipts?',
    a: 'Not if the digital copy meets the IRS conditions above. Plenty of drivers keep a shoebox anyway for the first year until they trust the app. That is fine too.',
  },
  {
    // No prices here on purpose — the Play Store listing is the only place a
    // number should come from. State what each plan does, nothing more.
    q: "What's the difference between Free, Pro, and Fleet?",
    a: 'Free keeps your receipts on your device, with limits on how many you can store, and no cloud sync or AI extraction. Pro adds cloud sync of redacted receipts, AI extraction of the merchant, date, and total, data export, and optional backup of your original images — that backup is off unless you turn it on. Fleet adds organization management on top of Pro, so a company or administrator can manage receipts across a fleet. Check the Google Play listing for current pricing, since we would rather you see the real number than one we typed on a marketing page.',
  },
];

const steps = [
  { n: 1, h: 'Snap it', p: 'Open the app, point at the receipt. One hand, no typing, works with the engine running.' },
  { n: 2, h: 'AI reads it', p: "CabSnap pulls the vendor, date, and total off the paper automatically. You don't key anything in." },
  { n: 3, h: "It's kept", p: 'Filed and searchable. Throw the paper away — the copy that matters is on your phone.' },
];

const problems = [
  { h: 'The glovebox pile', p: "You mean to sort it. You never sort it. By April it's a paper brick nobody can read." },
  { h: 'The fade', p: 'Thermal receipts go blank in a few weeks in a hot cab. A blank receipt proves nothing.' },
  { h: 'The shrug', p: "Can't find it, so you don't claim it. Every receipt you lose is a deduction denied." },
];
---

<Base
  title="CabSnap — Receipt App for Truck Drivers & Owner-Operators"
  description={SITE.description}
  path="/"
  faq={faq}
>
  <header class="dark hero">
    {/* .hero-in carries no styles below 1024px — it is the grid container the
        two-column desktop hero needs, and inert everywhere else. */}
    <div class="hero-in">
      <div class="hero-photo">
        <img
          src="/img/hero-cab.webp"
          width="1200" height="1500"
          alt="A driver photographing a fuel receipt on the steering wheel of a truck cab"
          fetchpriority="high"
        />
      </div>
      <div class="hero-copy">
        <div class="wrap">
          <p class="eyebrow orange">Receipt app for owner-operators</p>
          <h1>Snap the receipt.<br />Keep the <em>deduction</em>.</h1>
          <p class="lead measure">
            Point your phone at any receipt. CabSnap's AI reads it, files it, and keeps it —
            so it's still there when your accountant asks in April.
          </p>
          <Cta />
        </div>
      </div>
    </div>
  </header>

  <section>
    <div class="wrap">
      <p class="eyebrow">The problem</p>
      <h2>Receipts don't get lost.<br />They get ignored.</h2>
      <figure>
        <img src="/img/glovebox.webp" width="900" height="900" loading="lazy"
             alt="An open glove compartment crammed with crumpled paper receipts" />
        <figcaption>The filing system most owner-operators actually use.</figcaption>
      </figure>
      <div class="stack">
        {problems.map((p) => (
          <div class="cell">
            <h3>{p.h}</h3>
            <p>{p.p}</p>
          </div>
        ))}
      </div>
      <figure>
        <img src="/img/faded-receipt.webp" width="1200" height="900" loading="lazy"
             alt="A thermal paper receipt on a dashboard, its printing faded to almost nothing" />
        <figcaption>Six weeks on a dashboard. This one is worth nothing now.</figcaption>
      </figure>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2>Three seconds<br />at the pump.</h2>
      <div class="steps">
        {steps.map((s) => (
          <div class="step">
            <div class="step-n">{s.n}</div>
            <div>
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Who it's built for</p>
      <h2>People who buy<br />their own fuel.</h2>
      <figure>
        <img src="/img/hands-receipts.webp" width="900" height="900" loading="lazy"
             alt="A driver's hands holding a stack of crumpled receipts at a truck stop fuel island" />
      </figure>
      <div class="who">
        {AUDIENCES.map((a) => (
          <a href={`/receipt-app-for-${a.slug}`}>
            <span>{a.label}</span>
            <small>{a.note}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <IrsProof />

  <div class="calcwrap narrow">
    <div class="wrap">
      <p class="eyebrow orange">Free tool</p>
      <h2>How much did you spend that you can't prove?</h2>
      <p class="intro measure">Four questions. No signup to see the number.</p>
      <div class="calc">
        <small>Undocumented spend, last 12 months</small>
        <div class="big">$7,860</div>
        <small>example result</small>
        <a href="/tools/undocumented-spend-calculator">Run the numbers &rarr;</a>
      </div>
    </div>
  </div>

  <section class="topline narrow">
    <div class="wrap">
      <p class="eyebrow">Questions</p>
      <h2>Straight answers.</h2>
      <Faq items={faq} />
    </div>
  </section>

  <div class="dark closing">
    <div class="wrap">
      <h2>The paper fades.<br />The <em>photo doesn't</em>.</h2>
      <Cta />
    </div>
  </div>
</Base>

<style>
  /* .hero-photo and .hero-copy live in global.css so the homepage and the
     audience pages cannot drift apart again. No height is set here on
     purpose — the section is sized by its content. */
  .eyebrow.orange { color: var(--orange); }
  h1 em { font-style: normal; color: var(--orange); }
  /* Its own cap is tighter than .measure's, and it is hero copy: it holds
     the left edge of the headline above it rather than centring. */
  .lead { font-size: 18px; margin-top: 16px; max-width: 27em; margin-inline: 0; }

  /* figure / figure img / figcaption live in global.css — the same block
     renders on all six audience pages. */

  .stack { margin-top: 26px; display: flex; flex-direction: column; gap: 1px; background: var(--rule); }
  .cell { background: var(--paper); padding: 20px 0; }
  .cell h3 { margin-bottom: 6px; }
  .cell p { font-size: 15.5px; }

  .steps { margin-top: 28px; display: flex; flex-direction: column; gap: 26px; }
  .step { display: grid; grid-template-columns: 44px 1fr; gap: 14px; align-items: start; }
  .step-n {
    font-family: var(--font-display); font-weight: 900;
    font-size: 38px; color: var(--orange); line-height: .8;
  }
  .step h3 { margin-bottom: 5px; }
  .step p { font-size: 15.5px; }

  .who { margin-top: 26px; display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
  .who a {
    display: block; text-decoration: none; color: var(--text);
    background: var(--card); border: 1px solid var(--rule);
    border-radius: 4px; padding: 16px 14px;
  }
  .who span {
    display: block; font-family: var(--font-display); font-weight: 800;
    text-transform: uppercase; font-size: 19px; line-height: 1.05;
  }
  .who small {
    display: block; color: var(--muted); font-size: 12.5px;
    margin-top: 5px; font-family: var(--font-mono);
  }

  .calcwrap { background: var(--navy-2); color: var(--paper); padding: 52px 0; }
  .calcwrap p { color: #C3CADA; }
  .calcwrap .intro { margin-top: 16px; }
  .calc {
    border: 1px dashed rgba(242,107,33,.6); border-radius: 5px;
    padding: 26px 18px; margin-top: 24px; text-align: center;
    background: rgba(0,0,0,.18);
  }
  .calc .big {
    font-family: var(--font-display); font-weight: 900; font-size: 56px;
    color: var(--orange); line-height: 1; margin: 12px 0 4px;
  }
  .calc small {
    font-family: var(--font-mono); font-size: 12px;
    color: var(--muted-dk); display: block;
  }
  .calc a {
    display: inline-block; margin-top: 20px; color: var(--paper);
    border-bottom: 2px solid var(--orange); text-decoration: none;
    font-family: var(--font-display); font-weight: 800;
    text-transform: uppercase; font-size: 19px; padding-bottom: 2px;
  }

  .topline { border-top: 1px solid var(--rule); }
  .closing { text-align: center; padding: 56px 0; border-bottom: none; }
  .closing h2 { margin-bottom: 4px; }
  .closing em { font-style: normal; color: var(--orange); }

  /* --- desktop ---------------------------------------------------------
     Stacked lists become columns. Nothing below 768px is touched. */
  @media (min-width: 768px) {
    /* Three problem cards side by side. The 1px-gap-over-a-rule-background
       trick that draws the stacked dividers has no meaning across a row, so
       each card carries its own top rule instead. Grid rows stretch, so the
       three are equal height whatever the copy does. */
    .stack {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      background: none;
    }
    .cell {
      border-top: 2px solid var(--navy);
      padding: 16px 0 0;
    }

    /* Three steps across. The numeral moves above its heading rather than
       beside it — at a third of the width, a 44px gutter is most of the
       column. */
    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
    .step { grid-template-columns: 1fr; gap: 8px; }

    .who { grid-template-columns: repeat(3, 1fr); gap: 12px; }
  }

  @media (min-width: 1024px) {
    .calcwrap { padding: 80px 0; }
    .closing { padding: 84px 0; }
    .who a { padding: 24px 20px; }
  }
</style>
