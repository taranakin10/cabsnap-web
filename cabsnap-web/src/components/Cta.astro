---
import { CTA, PLAY_STORE_URL } from '../config';

/**
 * The primary CTA. The platform line lives here rather than in each page so
 * every CTA on the site carries the same honest one-liner, and so the iOS
 * swap in Base.astro has a consistent shape to work with.
 *
 * No id on the button: it is rendered more than once per page, and the
 * duplicate id it used to carry was only there for a nav anchor that no
 * longer exists.
 */
interface Props { label?: string; note?: boolean; }
const { label = CTA.primary, note = true } = Astro.props;
---
<a class="btn" href={PLAY_STORE_URL} data-play-store rel="noopener">{label}</a>
{note && <p class="btn-note">{CTA.note}</p>}
<p class="platform">{CTA.platform}</p>

<style>
  /* Deliberately quiet: this is a disclosure, not a badge, and it must not
     compete with the button above it. */
  .platform {
    text-align: center;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }
  :global(.dark) .platform { color: var(--muted-dk); }
</style>
