---
import Base from './Base.astro';
interface Props { title: string; description: string; path: string; heading: string; updated?: string; }
const { title, description, path, heading, updated } = Astro.props;
---
<Base title={title} description={description} path={path} narrow>
  <section class="prose">
    <div class="wrap">
      <h1>{heading}</h1>
      {updated && <p class="updated">Last updated {updated}</p>}
      <slot />
    </div>
  </section>
</Base>

<style is:global>
  .prose h1 { font-size: clamp(38px, 10vw, 52px); }
  .prose .updated {
    font-family: var(--font-mono); font-size: 12px;
    color: var(--muted); margin-top: 14px;
  }
  .prose h2 { font-size: 26px; margin-top: 38px; }
  .prose h3 { font-size: 19px; margin-top: 26px; }
  .prose p { margin-top: 14px; }
  .prose ul, .prose ol { margin-top: 14px; padding-left: 22px; }
  .prose li { margin-top: 7px; color: var(--text-body); }
  .prose a { color: var(--orange-ink); }
  /* `.prose a` outranks `.btn`, so a CTA dropped into a prose page would take
     the link colour and render orange text on the orange button. */
  .prose a.btn { color: var(--navy); }
  .prose .note {
    background: var(--card); border-left: 3px solid var(--orange);
    padding: 16px 18px; margin-top: 22px; border-radius: 0 4px 4px 0;
    font-size: 15px;
  }

  /* The column width comes from `narrow` on <Base> above, which every Prose
     page inherits — these pages are read line by line and a 1080px measure
     makes that harder, not easier. Only the per-element caps live here. */
  @media (min-width: 768px) {
    .prose p, .prose li, .prose .note { max-width: 68ch; }
  }
  @media (min-width: 1024px) { .prose { padding: 80px 0; } }
</style>
