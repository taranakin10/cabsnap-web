---
import { CTA, PLAY_STORE_URL } from '../config';
import PlayBadge from './PlayBadge.astro';

/**
 * The primary CTA.
 *
 * Two links, deliberately: the orange button is ours and carries no Google
 * branding at all, and the official Google Play badge sits below it
 * unmodified. Google's mark appears only on Google's badge — mixing the two
 * would mean recolouring or breaking up a locked-up trademark.
 *
 * The platform line lives here so every CTA on the site carries the same
 * disclosure, and so the iOS swap in Base.astro has a consistent shape.
 *
 * No id on the button: it renders more than once per page.
 */
/**
 * `placement` names where on the page this CTA sits. It is combined with the
 * page key into the `source` on PlayStoreClick — see the click handler in
 * Base.astro — so the report can tell a hero click from a closing-band one.
 * The button and the badge get their own suffixed values: a page rendering
 * <Cta placement="hero" /> reports `<page>-hero-button` and `<page>-hero-badge`.
 *
 * A page that renders this component twice MUST pass two different values.
 */
interface Props { label?: string; note?: boolean; placement?: string; }
const { label = CTA.primary, note = true, placement = 'cta' } = Astro.props;
---
{/* The four pieces are wrapped so desktop can hold them to one column and
    move them as a unit. Without it the button could be capped but the badge
    and the note would still centre against the full container, which is what
    put the badge off-axis from the button it belongs to. .cta carries no
    styles below 768px. */}
<div class="cta">
  {/* target="_blank" so the page survives the click: fbq gets to send
      PlayStoreClick instead of racing an unload. */}
  <a
    class="btn"
    href={PLAY_STORE_URL}
    data-play-store
    data-play-placement={`${placement}-button`}
    target="_blank"
    rel="noopener"
  >{label}</a>
  {note && <p class="btn-note">{CTA.note}</p>}

  <PlayBadge placement={`${placement}-badge`} />

  <p class="platform">
    Android only. <a href="/iphone">iPhone version</a> in development.
  </p>
</div>

<style>
  /* Deliberately quiet: this is a disclosure, not a badge, and it must not
     compete with the button above it. */
  .platform {
    text-align: center;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }
  .platform a { color: inherit; text-underline-offset: 2px; }
  :global(.dark) .platform { color: var(--muted-dk); }
</style>
