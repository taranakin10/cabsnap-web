---
import { PLAY_STORE_URL } from '../config';

/**
 * The nav CTA links straight to the Play Store. It used to point at "#get",
 * an anchor that only existed on the homepage, so on every other page the
 * button went nowhere. data-play-store opts it into the UTM passthrough and
 * PlayStoreClick tracking in Base.astro.
 */
---
<nav>
  <div class="nav-in">
    <a class="logo" href="/">Cab<span>Snap</span></a>
    <a class="nav-cta" href={PLAY_STORE_URL} data-play-store rel="noopener">
      <svg class="gp" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594z"/>
        <path d="M1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924z"/>
        <path d="M13.544 10.989l3.258-3.238L3.45.195a1.466 1.466 0 0 0-1.078-.155l11.172 10.949z"/>
        <path d="M13.544 13.003L2.352 23.96c.37.084.767.02 1.098-.169l13.484-7.629-3.39-3.159z"/>
      </svg>
      <span>Google Play</span>
    </a>
  </div>
</nav>

<style>
  nav {
    position: sticky; top: 0; z-index: 50;
    background: var(--navy);
    border-bottom: 1px solid rgba(0,0,0,.3);
  }
  .nav-in {
    max-width: var(--maxw); margin-inline: auto;
    padding: 12px var(--pad);
    display: flex; align-items: center; justify-content: space-between;
  }
  .logo {
    font-family: var(--font-display); font-weight: 900;
    font-size: 24px; letter-spacing: -.02em; text-transform: uppercase;
    color: var(--paper); text-decoration: none;
  }
  /* brand green sits on navy at ~6:1 — the only place it is legible */
  .logo span { color: var(--green); }
  .nav-cta {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-display); font-weight: 800;
    text-transform: uppercase; font-size: 15px; letter-spacing: .04em;
    background: var(--orange); color: var(--navy);
    padding: 8px 15px; border-radius: 3px; text-decoration: none;
  }
  .nav-cta .gp {
    width: 15px; height: 15px; flex: none;
    fill: currentColor;
  }
</style>
