---
import Cta from './Cta.astro';

/** The closing dark band with the final CTA. */
interface Props { html?: string; placement?: string; }
const {
  html = "The paper fades.<br />The <em>photo doesn't</em>.",
  placement = 'closing',
} = Astro.props;
---
<div class="dark closing">
  <div class="wrap">
    <h2 set:html={html} />
    <Cta placement={placement} />
  </div>
</div>

<style>
  .closing { text-align: center; padding: 56px 0; border-bottom: none; }
  .closing h2 { margin-bottom: 4px; }
  .closing :global(h2 em) { font-style: normal; color: var(--orange); }

  @media (min-width: 1024px) { .closing { padding: 84px 0; } }
</style>
