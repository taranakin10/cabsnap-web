---
import { IRS } from '../config';
---
<div class="dark band">
  <div class="wrap">
    <p class="eyebrow">Why a photo counts</p>
    <h2>The IRS takes<br />digital copies.</h2>
    <p class="intro">
      You don't have to keep the paper. The IRS has accepted electronic records
      since 1997, as long as the copies meet a few basic conditions.
    </p>
    <ul>
      {IRS.conditions.map((c) => <li>{c}</li>)}
    </ul>
    <p class="src">Source: {IRS.citation}. CabSnap is a recordkeeping tool, not a tax advisor.</p>
  </div>
</div>

<style>
  .band { padding: 52px 0; }
  .intro { margin-top: 16px; }
  ul { list-style: none; margin-top: 22px; display: flex; flex-direction: column; gap: 11px; }
  li { padding-left: 28px; position: relative; font-size: 15.5px; }
  /* green as confirmation — its one job besides the logo */
  li::before {
    content: "\2713"; position: absolute; left: 0;
    color: var(--green); font-weight: 700; font-size: 16px;
  }
  .src {
    font-family: var(--font-mono); font-size: 11.5px;
    color: var(--muted-dk); margin-top: 20px; padding-top: 16px;
    border-top: 1px solid var(--rule-dk);
  }
</style>
